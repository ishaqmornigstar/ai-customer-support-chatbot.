      "responses": [
        "Hello! How can I help you today?",
        "Hi! Welcome to customer support."
      ]
    },
    {
      "tag": "order_tracking",
      "patterns": [
        "where is my order",
        "track my package",
        "track my parcel",
        "order tracking",
        "order status",
        "where is my parcel",
        "when will my order arrive",
        "my package has not arrived",
        "delivery tracking",
        "I want to check my order"
      ],
      "responses": [
        "Please provide your order number to our support team for tracking.",
        "You can check your order status using your tracking number."
      ]
    },
    {
      "tag": "refund",
      "patterns": [
        "I want a refund",
        "refund my money",
        "how to get a refund",
        "refund status",
        "return my money",
        "I need my money back",
        "request a refund",
        "how can I get my money back",
        "refund process",
        "payment refund"
      ],
      "responses": [
        "I can help explain the refund process. Please contact our support team with your order number."
      ]
    },
    {
      "tag": "damaged_product",
      "patterns": [
        "my product is damaged",
        "I received a broken item",
        "product is defective",
        "damaged package",
        "broken product",
        "item arrived damaged",
        "my item is not working",
        "received a faulty product",
        "product has a defect",
        "I received a damaged order"
      ],
      "responses": [
        "I'm sorry about that. Please contact our support team with your order number and photos of the damaged item."
